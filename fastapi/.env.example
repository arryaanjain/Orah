# FastAPI ML Service Configuration
APP_NAME="PIMS ML Service"
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8001

# Paths
DATA_DIR=../backend
MODELS_DIR=./models
LOGS_DIR=./logs

# Laravel API (for auth verification)
LARAVEL_API_URL=http://127.0.0.1:8000/api

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model settings
FORECAST_HORIZON_DAYS=14
MIN_TRAINING_SAMPLES=30
